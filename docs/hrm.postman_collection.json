            ],
            "url": {
              "raw": "{{base_url}}/api/hrm/staff?department_id=12",
              "host": ["{{base_url}}"],
              "path": ["api", "hrm", "staff"],
              "query": [
                { "key": "department_id", "value": "12" }
              ]
            }
          }
        },
        {
          "name": "List Staff — directors only",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept",        "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/hrm/staff?is_department_director=true",
              "host": ["{{base_url}}"],
              "path": ["api", "hrm", "staff"],
              "query": [
                { "key": "is_department_director", "value": "true" }
              ]
            }
          }
        },
        {
          "name": "Show Staff",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept",        "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/hrm/staff/1",
              "host": ["{{base_url}}"],
              "path": ["api", "hrm", "staff", "1"]
            },
            "description": "Staff detail: department, position, employeeStaff.employee."
          }
        }
      ]
    },
    {
      "name": "👤 Employees",
      "item": [
        {
          "name": "List Employees",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept",        "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/hrm/employees?rows=20&page=1",
              "host": ["{{base_url}}"],
              "path": ["api", "hrm", "employees"],
              "query": [
                { "key": "rows", "value": "20" },
                { "key": "page", "value": "1" },
                { "key": "s",             "value": "", "description": "Ism / familiya / tabel qidirish", "disabled": true },
                { "key": "is_active",     "value": "", "description": "true / false",                   "disabled": true },
                { "key": "department_id", "value": "", "description": "Bo'lim bo'yicha filter",         "disabled": true }
              ]
            },
            "description": "Xodimlar ro'yxati. `full_name` — computed attribute (lastname + firstname + middle_name)."
          }
        },
        {
          "name": "List Employees — search",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept",        "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/hrm/employees?s=akbar",
              "host": ["{{base_url}}"],
              "path": ["api", "hrm", "employees"],
              "query": [
                { "key": "s", "value": "akbar" }
              ]
            }
          }
        },
        {
          "name": "List Employees — active only",
