            ],
            "url": {
              "raw": "{{base_url}}/api/hrm/staff?rows=20&page=1",
              "host": ["{{base_url}}"],
              "path": ["api", "hrm", "staff"],
              "query": [
                { "key": "rows", "value": "20" },
                { "key": "page", "value": "1" },
                { "key": "department_id",          "value": "", "description": "Bo'lim ID", "disabled": true },
                { "key": "position_id",            "value": "", "description": "Lavozim ID", "disabled": true },
                { "key": "is_department_director", "value": "", "description": "true / false", "disabled": true }
              ]
            },
            "description": "Shtat birliklari ro'yxati (department + position translations bilan)."
          }
        },
        {
          "name": "List Staff — by department",
          "request": {
            "method": "GET",
            "header": [
