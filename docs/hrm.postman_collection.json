              { "key": "Accept",        "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/hrm/employee-staff?rows=20&page=1",
              "host": ["{{base_url}}"],
              "path": ["api", "hrm", "employee-staff"],
              "query": [
                { "key": "rows", "value": "20" },
                { "key": "page", "value": "1" },
                { "key": "employee_id",  "value": "", "description": "Xodim ID",         "disabled": true },
                { "key": "department_id","value": "", "description": "Bo'lim ID",         "disabled": true },
                { "key": "staff_id",     "value": "", "description": "Shtat ID",          "disabled": true },
                { "key": "main_staff",   "value": "", "description": "true / false",      "disabled": true }
              ]
            },
            "description": "Xodim-shtat bog'liqliklari ro'yxati."
          }
        },
        {
          "name": "List Employee-Staff — by employee",
