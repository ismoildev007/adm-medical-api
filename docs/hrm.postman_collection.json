            }
          }
        },
        {
          "name": "List Employees — by department",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept",        "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/hrm/employees?department_id=12",
              "host": ["{{base_url}}"],
              "path": ["api", "hrm", "employees"],
              "query": [
                { "key": "department_id", "value": "12" }
              ]
            }
          }
        },
        {
          "name": "Show Employee",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept",        "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/hrm/employees/2048",
              "host": ["{{base_url}}"],
              "path": ["api", "hrm", "employees", "2048"]
            },
            "description": "Xodim detail: employeeStaff (department, position, staff) bilan."
          }
        }
      ]
    },
    {
      "name": "🔗 Employee-Staff",
      "item": [
        {
          "name": "List Employee-Staff",
          "request": {
